{
  "name": "compose-anywhere",
  "version": "1.0.0",
  "description": "Visual component placement tool - drop any component on any website",
  "main": "src/bookmarklet.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:screenshots": "playwright test external-sites --project=chromium",
    "test:workflow": "./test-workflow.sh",
    "test:quick": "claude 'Test bookmarklet on local test page'",
    "test:live": "claude 'Test bookmarklet on https://news.ycombinator.com'",
    "test:multi": "claude --dangerously-skip-permissions 'Test on 5 different websites'",
    "dev": "claude 'Start interactive development mode with hot reload'",
    "docs": "claude 'Generate documentation from TSDoc comments'",
    "build": "node scripts/build-bookmarklet.js",
    "build:legacy": "node scripts/create-bookmarklet.js",
    "serve": "serve . -p 8080",
    "review": "./.claude/commands/review.sh",
    "format": "prettier --write '**/*.{js,json,md}'",
    "clean": "rm -rf test-results/ screenshots/ docs/generated/ examples/generated/ dist/"
  },
  "keywords": [
    "component",
    "placement",
    "embed",
    "bookmarklet",
    "visual",
    "web-components",
    "shadow-dom",
    "integration",
    "compose",
    "anywhere",
    "drop",
    "widget"
  ],
  "author": "Max Albrecht (eins78)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eins78/compose-anywhere.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "bookmarklet": "^3.0.0",
    "prettier": "^3.2.4",
    "puppeteer": "^24.22.0",
    "serve": "^14.2.1",
    "terser": "^5.44.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "browserslist": [
    "Chrome >= 88",
    "Firefox >= 63",
    "Safari >= 15.4",
    "Edge >= 88"
  ],
  "claude": {
    "mcp": {
      "primary": "puppeteer",
      "required": [
        "puppeteer",
        "filesystem"
      ],
      "optional": [
        "git",
        "playwright"
      ]
    },
    "workflows": {
      "preferred": "test-workflow.sh",
      "updateDocs": true
    }
  },
  "packageManager": "pnpm@9.8.0+sha512.8e4c3550fb500e808dbc30bb0ce4dd1eb614e30b1c55245f211591ec2cdf9c611cabd34e1364b42f564bd54b3945ed0f49d61d1bbf2ec9bd74b866fcdc723276"
}
